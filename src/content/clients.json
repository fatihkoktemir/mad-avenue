  "hints": {
    "audience": {
      "youth": [
        "We want the kids talking about us on the school bus.",
        "Our buyers are young, loud and restless.",
        "Teenagers. You know, the ones with the transistor radios."
      ],
      "families": [
        "Think of the whole family at the dinner table.",
        "Moms do the shopping and we want Moms on our side.",
        "Something the kids and grandma can both enjoy."
      ],
      "adults": [
        "Our customers have mortgages and good taste.",
        "We sell to grown-ups who work hard for their money.",
        "The country club crowd, if you follow me."
      ],
      "women": [
        "Our real customer is the lady of the house.",
        "Women buy most of what we sell. Talk to them.",
        "Think of the modern woman, the one with her own checkbook."
      ]
    },
    "objective": {
      "awareness": [
        "Nobody in town knows our name yet.",
        "We need people to remember us. That's all.",
        "Make us the first thing they think of."
      ],
      "consideration": [
        "People know us, but they don't know why we're better.",
        "Tell them what makes us worth the extra nickel.",
        "Give them a reason to pick us off the shelf."
      ],
      "steal": [
        "The fella across the street is eating our lunch.",
        "We want his customers. All of them.",
        "Our rival has had it too easy for too long."
      ]
    },
    "risk": {
      "low": "Nothing too wild, please. My board is very conservative.",
      "high": "Shake things up. Boring won't cut it."
    }
